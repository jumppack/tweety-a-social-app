#!/bin/sh
# Pre-commit: fast checks on what you're about to commit.
# Installed automatically by `pnpm install` (the root "prepare" script sets core.hooksPath).
# Skip once with `git commit --no-verify`.
set -e

# 1. Lint + format check only the staged files (milliseconds).
pnpm exec biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error

# 2. Typecheck only packages with changes since HEAD, plus their dependents.
#    Turbo's cache makes this near-instant when nothing relevant changed.
#    On the very first commit there is no HEAD yet, so check everything.
if git rev-parse --verify --quiet HEAD >/dev/null; then
	pnpm exec turbo run typecheck --filter='...[HEAD]' --output-logs=errors-only
else
	pnpm exec turbo run typecheck --output-logs=errors-only
fi
